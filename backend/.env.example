POSTGRES_USER=psigestao
# Obrigatória: o docker-compose.yml usa esta senha no banco e na DATABASE_URL
# da API (não existe mais senha fixa no compose). Gere uma aleatória com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=psigestao
# Domínios do frontend, separados por vírgula. Em produção "*" impede o servidor de subir.
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET=gere-uma-string-aleatoria-longa
# Duração da sessão de login, em horas (padrão 12).
JWT_EXPIRE_HOURS=12
# Limite de tentativas em login/cadastro/webhook/busca/exportação.
# Em produção "false" é recusado: o servidor não sobe.
RATE_LIMIT_ENABLED=true
# Sem esta variável (ou com qualquer valor diferente de "development") o servidor
# roda como PRODUÇÃO: cookie secure (exige HTTPS), segredos obrigatórios e /docs
# desligado. Use "development" SÓ na sua máquina; em produção, apague esta linha.
ENVIRONMENT=development
# Chave de criptografia dos prontuários. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde um backup seguro desta chave: se ela for perdida, os dados criptografados não podem ser recuperados.
FERNET_KEY=gere-uma-chave-fernet
# Opcional, só durante uma troca de chave: chaves antigas (separadas por vírgula) usadas apenas para ler.
FERNET_OLD_KEYS=
DATABASE_URL=postgresql+asyncpg://psigestao:troque-esta-senha@localhost:5432/psigestao
GOOGLE_CLIENT_ID="SEU_ID.apps.googleusercontent.com"

# Política de Privacidade (backend/legal.py). A LGPD (art. 41) exige divulgar
# quem é o controlador e o contato do encarregado (DPO). Em produção, o
# servidor registra um alerta crítico enquanto estes campos estiverem vazios.
PRIVACY_CONTROLLER_NAME=Razão social de quem opera o PsiGestão
PRIVACY_CONTROLLER_DOCUMENT=00.000.000/0001-00
PRIVACY_DPO_NAME=Nome do encarregado
PRIVACY_DPO_EMAIL=privacidade@seudominio.com.br

# Análise de UI (O2): e-mail de suporte mostrado na página de Ajuda (/ajuda).
# Opcional: sem ele, a página mostra só o contato do encarregado (acima).
SUPPORT_EMAIL=suporte@seudominio.com.br

# Produto (assinatura; regras em backend/billing.py).
# Meio de pagamento: vazio = nenhum (teste grátis e cortesia funcionam, mas o
# botão Assinar avisa "pagamento indisponível"); "simulado" = só desenvolvimento
# (a API se recusa a subir com ele em produção).
BILLING_PROVIDER=
# Preços em centavos (R$ 59,00 por mês; R$ 590,00 por ano), dias de teste grátis
# e dias de tolerância depois que um pagamento atrasa.
PRICE_MONTHLY_CENTS=5900
PRICE_ANNUAL_CENTS=59000
TRIAL_DAYS=14
BILLING_GRACE_DAYS=7

# Produto (administração; regras em backend/admin_access.py e server.py).
# E-mails das contas que veem a tela Administração (controle das contas:
# cortesia, prorrogar teste, encerrar sessões, suspender), separados por
# vírgula. Vazio = administração desligada. A conta precisa existir, ter o
# e-mail comprovado e a verificação em duas etapas ativa. Item que não é
# e-mail impede a API de subir. Para conferir o que falta:
# docker compose exec api python manage_billing.py admin verificar
ADMIN_EMAILS=

# --- Escala e monitoramento (produção) ---
# Chave do índice de busca por nome (crypto.py). Obrigatória em produção,
# mínimo 32 caracteres aleatórios. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se trocar, rode: python rebuild_search_index.py --all
SEARCH_INDEX_KEY=gere-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# Workers do gunicorn (padrão: nº de núcleos). Cada worker abre seu próprio
# pool: WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < max_connections do Postgres.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# OBRIGATÓRIO em produção (gunicorn.conf.py). De quem aceitar o IP real do
# usuário (cabeçalho X-Forwarded-For), usado no rate limit e na auditoria:
#   - IPs exatos do proxy, separados por vírgula (ex.: 10.0.0.5,10.0.0.6);
#   - "*" SÓ se a porta da API não for acessível de fora (apenas pelo proxy
#     da plataforma, ex.: Render, Railway, Fly);
#   - "127.0.0.1" se não houver proxy na frente da API.
FORWARDED_ALLOW_IPS=127.0.0.1
# OBRIGATÓRIO em produção: contador de tentativas compartilhado entre workers
# e instâncias, COM TLS (ex.: rediss://:senha@redis:6380/0). Sem ele, ou com
# redis:// (sem TLS), o servidor não sobe.
REDIS_URL=
# Só se o Redis estiver na MESMA máquina ou numa rede privada isolada:
# aceita redis:// sem TLS. Deixe vazio no caso normal.
REDIS_TLS_DISABLED=
# Só para implantação com UM processo (WEB_CONCURRENCY=1) e uma instância:
# aceita o contador em memória, sem Redis. Deixe vazio no caso normal.
RATE_LIMIT_ALLOW_MEMORY=
# Logs: "json" em produção (agregadores), "text" no desenvolvimento.
LOG_FORMAT=json
LOG_LEVEL=INFO
# /api/metrics (Prometheus): em produção só responde com
# "Authorization: Bearer <METRICS_TOKEN>"; sem token configurado, fica desligado.
METRICS_TOKEN=
# Sentry (opcional). Configurado para nunca enviar dados de pacientes.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Em produção as tabelas são criadas/migradas pelo prestart.py; deixe false.
AUTO_CREATE_TABLES=false
# Em produção a conexão com o banco precisa de TLS: termine o DATABASE_URL com
# ?ssl=require (ou ?ssl=verify-full, que também confere o certificado; CA em
# PGSSLROOTCERT). Banco na MESMA máquina ou rede privada isolada (ex.: serviço
# "db" do mesmo docker compose): DATABASE_TLS_DISABLED=true.
DATABASE_TLS_DISABLED=

# --- E-mail (cadastro, "Esqueci minha senha" e avisos de segurança) ---
# OBRIGATÓRIO em produção: sem SMTP criptografado o servidor não sobe.
# Qualquer provedor SMTP serve (Amazon SES, SendGrid, Brevo, Mailgun, Resend,
# Google Workspace...). No docker compose de desenvolvimento os e-mails vão
# para o Mailpit: abra http://localhost:8025 para vê-los.
SMTP_HOST=
SMTP_PORT=587
# starttls (porta 587) ou ssl (porta 465). "none" só no desenvolvimento.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="PsiGestão <nao-responda@seudominio.com.br>"
# Endereço do frontend nos links dos e-mails (padrão: a 1ª origem de CORS_ORIGINS).
# FRONTEND_URL fica no início deste arquivo.

# --- Manutenção automática ---
# Rotina que exclui o que sobrou das contas encerradas no fim da guarda legal
# e apaga os links de cadastro do paciente encerrados há mais de 30 dias.
# Roda dentro da API a cada N horas; também pode ser chamada por um
# agendador externo: python maintenance.py
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_HOURS=6

# Identificação do profissional (nome e CRP) no termo de consentimento e no
# PDF exportado, e o cadastro de nome/CRP nas Configurações. DESLIGADA na
# primeira versão (sistema só para profissionais). Ligue (true) quando o
# sistema for aberto aos pacientes; os dados já cadastrados voltam a aparecer.
SHOW_PROFESSIONAL_IDENTIFICATION=false
