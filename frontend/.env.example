# Endereço público da API (sem /api no final). Em produção é passado no build
# da imagem: --build-arg REACT_APP_BACKEND_URL=https://api.seudominio.com.br
REACT_APP_BACKEND_URL=http://localhost:5000
WDS_SOCKET_PORT=0
ENABLE_HEALTH_CHECK=false
# SÓ NO DESENVOLVIMENTO: endereço do túnel (ex.: ngrok) que leva o Google Forms
# até a API desta máquina. Em produção é ignorado: o script do Google Forms usa
# REACT_APP_BACKEND_URL + /api/webhook/google-forms (varredura, item 12).
WEBHOOK_URL=https://seu-tunel.ngrok-free.app/api/webhook/google-forms
REACT_APP_GOOGLE_CLIENT_ID=SEU_ID.apps.googleusercontent.com
