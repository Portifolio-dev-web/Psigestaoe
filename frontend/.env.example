# Endereço público da API (sem /api no final). Em produção é passado no build
# da imagem: --build-arg REACT_APP_BACKEND_URL=https://api.seudominio.com.br
REACT_APP_BACKEND_URL=http://localhost:5000
WDS_SOCKET_PORT=0
ENABLE_HEALTH_CHECK=false
REACT_APP_GOOGLE_CLIENT_ID=SEU_ID.apps.googleusercontent.com
