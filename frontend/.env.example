# Endereço público da API (sem /api no final). Em produção é passado no build
# da imagem: --build-arg REACT_APP_BACKEND_URL=https://api.seudominio.com.br
REACT_APP_BACKEND_URL=http://localhost:5000
WDS_SOCKET_PORT=0
ENABLE_HEALTH_CHECK=false
REACT_APP_GOOGLE_CLIENT_ID=SEU_ID.apps.googleusercontent.com

# --- Monitoramento de erros do navegador (I2, varredura) ---
# Opcional: vazio = Sentry desligado (lib/sentry.js nem baixa o pacote).
# Crie um projeto em sentry.io (região UE de preferência) e cole o DSN aqui;
# depois acrescente o domínio de ingestão do seu projeto ao connect-src do
# nginx.conf (comentário "DEPLOY (varredura, item I2)" lá) e liste o Sentry
# como terceiro na Política de Privacidade (backend/legal.py).
REACT_APP_SENTRY_DSN=
# "production" por padrão (process.env.NODE_ENV); use para distinguir
# ambientes no painel do Sentry (ex.: "staging").
REACT_APP_SENTRY_ENVIRONMENT=
# Rastreamento de desempenho: 0 (desligado) por padrão, como no backend.
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0
